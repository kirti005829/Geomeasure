{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "justMyCode": false
    },
    {
      "name": "Regenerate sample files",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_samples.py"
    }
  ]
}
